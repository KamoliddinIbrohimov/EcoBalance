:80 {
    # API — everything under /api/* goes to the NestJS container.
    # We use plain `handle` (not `handle_path`) so the /api/v1/... prefix
    # is preserved and forwarded to Nest as-is.
    handle /api* {
        reverse_proxy api:4000 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Public MinIO bucket (bosh sahifa kartalari va h.k.) — GET/HEAD only, bitta
    # doimiy origin (PUBLIC_ASSET_ORIGIN) orqali, MinIO'ni alohida host portga
    # chiqarish shart emas.
    handle /ecobalance-public/* {
        @disallowedMethod not method GET HEAD
        respond @disallowedMethod 405
        # Host header'ni qayta yozish shart emas — Caddy uni standart holatda
        # o'zgartirmasdan uzatadi, MinIO anonim GET uchun ham buni talab qilmaydi
        # (forcePathStyle, imzosiz so'rov). deploy-tekshiruv-prompt.md 3-band.
        reverse_proxy minio:9000
        header Cache-Control "public, max-age=600"
    }

    # Private bucket (dars materiallari, video darsliklar) — faqat API bergan
    # imzolangan (5 daqiqalik) URL bilan ochiladi; imzo Host'ni o'z ichiga oladi,
    # shuning uchun S3_PUBLIC_ENDPOINT shu domen bo'lishi va Host o'zgarmasligi kerak.
    # Range so'rovlari (video oldinga/orqaga surish) MinIO'ga to'g'ridan-to'g'ri o'tadi.
    handle /ecobalance-private/* {
        @disallowedMethod not method GET HEAD
        respond @disallowedMethod 405
        reverse_proxy minio:9000
        header Cache-Control "private, no-store"
    }

    # Everything else -> Next.js
    handle {
        reverse_proxy web:3000
    }

    # Compression
    encode zstd gzip

    # Basic security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    log {
        output stdout
        format console
    }
}

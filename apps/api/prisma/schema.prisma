// PedResearch Lab — Prisma schema.
//
// DB tuzilmasi prod bilan bir xil saqlanadi (ma'lumotlar o'zgartirishsiz
// ko'chadi). ID'lar UUIDv7, Prisma client tomonida generatsiya qilinadi.
// Eski 7-rolli modullardan qolgan jadvallar (organizations, news,
// eco_reports, permissions) ma'lumot saqlash uchun modelda turibdi.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// Enums
// ---------------------------------------------------------------

enum RoleSlug {
  SUPER_ADMIN
  TEACHER
  STUDENT
}

enum AssignmentSubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
  PENDING_REVIEW
}

enum AssignmentKind {
  TASK
  TIMED
  QUESTIONNAIRE
}

enum ContentVisibility {
  PRIVATE
  LIBRARY
}

enum GroupLessonReleaseStatus {
  LOCKED
  SCHEDULED
  OPEN
}

enum StudyEventType {
  LESSON_OPEN
  LESSON_HEARTBEAT
  LESSON_COMPLETE
  MATERIAL_OPEN
  QUIZ_START
  QUIZ_SUBMIT
  ASSIGNMENT_OPEN
  ASSIGNMENT_SUBMIT
}

enum OrganizationType {
  CITY
  DISTRICT
  MAHALLA
  SCHOOL
  KINDERGARTEN
  UNIVERSITY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETE
  TOKEN_REFRESH
  TOKEN_REVOKED
}

enum LessonType {
  MARUZA
  AMALIY
  LABORATORIYA
  EKSKURSIYA
}

enum EducationLevel {
  MAKTABGACHA
  MAKTAB
  OLIY_TALIM
  RESERVED
}

enum AiMessageRole {
  USER
  ASSISTANT
}

enum EcoReportCategory {
  WASTE
  WATER
  GREEN_AREA
  AIR_NOISE
  ENERGY
  OTHER
}

enum EcoReportRisk {
  LOW
  MEDIUM
  HIGH
}

enum EcoReportStatus {
  REPORTED
  IN_REVIEW
  IN_PROGRESS
  RESOLVED
}

enum QuizQuestionType {
  SINGLE_CHOICE // bitta to'g'ri javob, ballanadi
  LIKERT_5 // 1..5 shkala, ballanmaydi (likertSum'ga qo'shiladi)
}

enum QuizSubmissionStatus {
  IN_PROGRESS
  SUBMITTED
}

// ---------------------------------------------------------------
// Foydalanuvchilar va rollar
// ---------------------------------------------------------------

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  firstName          String    @map("first_name") @db.VarChar(100)
  lastName           String    @map("last_name") @db.VarChar(100)
  email              String    @unique @db.VarChar(255)
  phone              String?   @unique @db.VarChar(32)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  avatarUrl          String?   @map("avatar_url") @db.Text
  locale             String    @default("uz") @db.VarChar(8)
  emailVerifiedAt    DateTime? @map("email_verified_at")
  lastLoginAt        DateTime? @map("last_login_at")
  lastLoginIp        String?   @map("last_login_ip") @db.VarChar(45)
  isActive           Boolean   @default(true) @map("is_active")
  /// Vaqtincha parol — birinchi kirishda almashtirish shart.
  mustChangePassword Boolean   @default(false) @map("must_change_password")

  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  /// Kim yaratgan: SA o'qituvchi/talabani, o'qituvchi talabani.
  createdById  String? @map("created_by_id") @db.Uuid
  createdBy    User?   @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("UserCreator")

  roles                 UserRole[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  refreshTokens         RefreshToken[]
  passwordResets        PasswordResetToken[]
  ecoReports            EcoReport[]
  aiConversations       AiConversation[]
  news                  News[]
  quizSubmissions       QuizSubmission[]
  teachingGroups        Group[]                   @relation("GroupTeacher")
  groupMembership       GroupMember?
  ownedCourses          Course[]                  @relation("CourseOwner")
  ownedQuizzes          Quiz[]                    @relation("QuizOwner")
  lessonProgress        LessonProgress[]
  createdAssignments    Assignment[]              @relation("AssignmentCreator")
  assignmentSubmissions AssignmentSubmission[]    @relation("SubmissionAuthor")
  gradedSubmissions     AssignmentSubmission[]    @relation("SubmissionGrader")
  accommodations        AssignmentAccommodation[] @relation("AssignmentAccommodation")
  studySessions         StudySession[]            @relation("StudySessionOwner")
  studyEvents           StudyEvent[]              @relation("StudyEventOwner")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        RoleSlug @unique
  nameUz      String   @map("name_uz") @db.VarChar(120)
  description String?  @db.VarChar(500)

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Eski: ruxsatlar endi kodda (@eco/shared ROLE_PERMISSIONS). Jadval faqat
/// ma'lumot saqlash uchun qoldirilgan.
model Permission {
  id     String @id @db.Uuid
  slug   String @unique @db.VarChar(120)
  module String @db.VarChar(60)
  action String @db.VarChar(60)
  nameUz String @map("name_uz") @db.VarChar(160)

  roles RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Organization {
  id       String         @id @default(uuid(7)) @db.Uuid
  parentId String?        @map("parent_id") @db.Uuid
  parent   Organization?  @relation("OrgTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Organization[] @relation("OrgTree")

  type      OrganizationType
  nameUz    String           @map("name_uz") @db.VarChar(255)
  code      String           @unique @db.VarChar(60)
  address   Json?            @db.JsonB
  latitude  Decimal?         @db.Decimal(10, 7)
  longitude Decimal?         @db.Decimal(10, 7)

  users      User[]
  ecoReports EcoReport[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([type])
  @@map("organizations")
}

// ---------------------------------------------------------------
// Auth
// ---------------------------------------------------------------

model RefreshToken {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  /// Rotatsiya oilasi — qayta ishlatishni aniqlash uchun.
  familyId  String    @map("family_id") @db.Uuid
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime  @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id     String  @id @default(uuid(7)) @db.Uuid
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action      AuditAction
  subjectType String?     @map("subject_type") @db.VarChar(120)
  subjectId   String?     @map("subject_id") @db.Uuid
  changes     Json?       @db.JsonB
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  userAgent   String?     @map("user_agent") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([subjectType, subjectId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------
// Platforma
// ---------------------------------------------------------------

model PlatformSetting {
  key       String   @id @db.VarChar(80)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("platform_settings")
}

model Notification {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String    @db.VarChar(120)
  titleUz String    @map("title_uz") @db.VarChar(255)
  bodyUz  String    @map("body_uz") @db.Text
  data    Json?     @db.JsonB
  readAt  DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, readAt])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model News {
  id                  String  @id @default(uuid(7)) @db.Uuid
  titleUz             String  @map("title_uz") @db.VarChar(255)
  bodyUz              String  @map("body_uz") @db.Text
  attachmentKey       String? @map("attachment_key") @db.VarChar(500)
  attachmentFileName  String? @map("attachment_file_name") @db.VarChar(255)
  attachmentMimeType  String? @map("attachment_mime_type") @db.VarChar(120)
  attachmentSizeBytes Int?    @map("attachment_size_bytes")

  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")

  authorId String? @map("author_id") @db.Uuid
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isPublished, publishedAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("news")
}

model EcoReport {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  reportedBy     String        @map("reported_by") @db.Uuid
  reporter       User          @relation(fields: [reportedBy], references: [id], onDelete: Cascade)

  category      EcoReportCategory
  riskLevel     EcoReportRisk     @map("risk_level")
  status        EcoReportStatus   @default(REPORTED)
  descriptionUz String            @map("description_uz") @db.Text
  suggestionUz  String?           @map("suggestion_uz") @db.Text
  aiNoteUz      String?           @map("ai_note_uz") @db.Text

  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  locationLabel String?  @map("location_label") @db.VarChar(255)

  photoBeforeKey String? @map("photo_before_key") @db.VarChar(512)
  photoAfterKey  String? @map("photo_after_key") @db.VarChar(512)

  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([category])
  @@index([status])
  @@index([organizationId])
  @@index([createdAt(sort: Desc)])
  @@map("eco_reports")
}

// ---------------------------------------------------------------
// Kurslar, mavzular, darslar, materiallar
// ---------------------------------------------------------------

model Course {
  id             String            @id @default(uuid(7)) @db.Uuid
  slug           String            @unique @db.VarChar(80)
  nameUz         String            @map("name_uz") @db.VarChar(255)
  descriptionUz  String?           @map("description_uz") @db.Text
  /// education_level_items.slug — FK emas: daraja o'chsa ham kurs qoladi.
  educationLevel String            @map("education_level") @db.VarChar(60)
  isPublished    Boolean           @default(false) @map("is_published")
  /// LIBRARY — boshqa o'qituvchilar o'z guruhiga biriktira oladi (tahrirlay olmaydi).
  visibility     ContentVisibility @default(PRIVATE)

  ownerId String? @map("owner_id") @db.Uuid
  owner   User?   @relation("CourseOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  lessons     Lesson[]
  modules     Module[]
  materials   CourseMaterial[]
  groups      CourseGroup[]
  assignments Assignment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isPublished])
  @@index([educationLevel])
  @@index([ownerId])
  @@index([visibility])
  @@map("courses")
}

/// Sidebar'dagi ta'lim darajalari. isBuiltIn=true qatorlar o'chirilmaydi.
model EducationLevelItem {
  id            String          @id @default(uuid(7)) @db.Uuid
  slug          String          @unique @db.VarChar(60)
  nameUz        String          @map("name_uz") @db.VarChar(120)
  descriptionUz String?         @map("description_uz") @db.VarChar(500)
  iconName      String          @default("GraduationCap") @map("icon_name") @db.VarChar(60)
  orderIndex    Int             @default(0) @map("order_index") @db.SmallInt
  linkedEnum    EducationLevel? @map("linked_enum")
  isBuiltIn     Boolean         @default(false) @map("is_built_in")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderIndex])
  @@map("education_level_items")
}

model Module {
  id            String  @id @default(uuid(7)) @db.Uuid
  courseId      String  @map("course_id") @db.Uuid
  course        Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orderIndex    Int     @map("order_index") @db.SmallInt
  titleUz       String  @map("title_uz") @db.VarChar(255)
  descriptionUz String? @map("description_uz") @db.Text
  isPublished   Boolean @default(true) @map("is_published")

  lessons  Lesson[]
  releases GroupLessonRelease[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([courseId, orderIndex], map: "modules_course_order_unique")
  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id       String  @id @default(uuid(7)) @db.Uuid
  courseId String  @map("course_id") @db.Uuid
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId String? @map("module_id") @db.Uuid
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  orderIndex       Int        @map("order_index") @db.SmallInt
  lessonType       LessonType @map("lesson_type")
  titleUz          String     @map("title_uz") @db.VarChar(255)
  objectiveUz      String?    @map("objective_uz") @db.Text
  equipmentUz      String?    @map("equipment_uz") @db.Text
  theoryUz         String?    @map("theory_uz") @db.Text
  procedureUz      Json       @default("[]") @map("procedure_uz") @db.JsonB
  isPublished      Boolean    @default(true) @map("is_published")
  /// Soft-delete: progress saqlanadi, ro'yxatlardan yashiriladi.
  archivedAt       DateTime?  @map("archived_at")
  estimatedMinutes Int?       @map("estimated_minutes") @db.SmallInt

  materials     CourseMaterial[]
  quizzes       Quiz[]
  progress      LessonProgress[]
  assignments   Assignment[]
  releases      GroupLessonRelease[]
  studySessions StudySession[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([courseId, orderIndex], map: "lessons_course_order_unique")
  @@index([courseId])
  @@index([lessonType])
  @@index([moduleId])
  @@index([archivedAt])
  @@map("lessons")
}

/// Dars yoki mavzu guruh uchun qachon ochilishi.
model GroupLessonRelease {
  id       String                   @id @default(uuid(7)) @db.Uuid
  groupId  String                   @map("group_id") @db.Uuid
  group    Group                    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lessonId String?                  @map("lesson_id") @db.Uuid
  lesson   Lesson?                  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  moduleId String?                  @map("module_id") @db.Uuid
  module   Module?                  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  opensAt  DateTime?                @map("opens_at")
  closesAt DateTime?                @map("closes_at")
  status   GroupLessonReleaseStatus @default(LOCKED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([groupId, lessonId, moduleId], map: "group_release_unique")
  @@index([groupId])
  @@index([lessonId])
  @@index([moduleId])
  @@map("group_lesson_releases")
}

/// contentText — fayldan chiqarilgan matn, chatbot konteksti uchun.
model CourseMaterial {
  id       String  @id @default(uuid(7)) @db.Uuid
  courseId String  @map("course_id") @db.Uuid
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId String? @map("lesson_id") @db.Uuid
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  fileName    String  @map("file_name") @db.VarChar(255)
  storageKey  String  @unique @map("storage_key") @db.VarChar(512)
  mimeType    String  @map("mime_type") @db.VarChar(120)
  sizeBytes   Int     @map("size_bytes")
  uploadedBy  String? @map("uploaded_by") @db.Uuid
  contentText String? @map("content_text") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([courseId])
  @@index([lessonId])
  @@map("course_materials")
}

// ---------------------------------------------------------------
// AI chatbot
// ---------------------------------------------------------------

model AiConversation {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String @db.VarChar(255)

  messages AiMessage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([updatedAt(sort: Desc)])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(uuid(7)) @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiMessageRole
  content        String         @db.Text
  tokens         Int?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("ai_messages")
}

// ---------------------------------------------------------------
// Testlar
// ---------------------------------------------------------------

/// lessonId null bo'lsa — mustaqil ("Ekologik monitoring") test.
model Quiz {
  id               String            @id @default(uuid(7)) @db.Uuid
  lessonId         String?           @map("lesson_id") @db.Uuid
  lesson           Lesson?           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  titleUz          String            @map("title_uz") @db.VarChar(255)
  descriptionUz    String?           @map("description_uz") @db.Text
  /// Ballanadigan savollar bo'yicha o'tish foizi (0..100).
  passPercent      Int               @default(60) @map("pass_percent") @db.SmallInt
  isPublished      Boolean           @default(false) @map("is_published")
  visibility       ContentVisibility @default(PRIVATE)
  /// Standart taymer (daqiqa); GroupQuiz ustidan yozishi mumkin.
  timeLimitMinutes Int?              @map("time_limit_minutes") @db.SmallInt

  ownerId String? @map("owner_id") @db.Uuid
  owner   User?   @relation("QuizOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  questions   QuizQuestion[]
  submissions QuizSubmission[]
  groups      GroupQuiz[]
  assignments Assignment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lessonId])
  @@index([isPublished])
  @@index([visibility])
  @@map("quizzes")
}

/// options: SINGLE_CHOICE → [{key,textUz,isCorrect}], LIKERT_5 → [].
model QuizQuestion {
  id         String           @id @default(uuid(7)) @db.Uuid
  quizId     String           @map("quiz_id") @db.Uuid
  quiz       Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  orderIndex Int              @map("order_index") @db.SmallInt
  type       QuizQuestionType
  textUz     String           @map("text_uz") @db.Text
  options    Json             @default("[]") @db.JsonB

  answers QuizAnswer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([quizId, orderIndex], map: "quiz_questions_quiz_order_unique")
  @@index([quizId])
  @@map("quiz_questions")
}

model QuizSubmission {
  id     String               @id @default(uuid(7)) @db.Uuid
  quizId String               @map("quiz_id") @db.Uuid
  quiz   Quiz                 @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId String               @map("user_id") @db.Uuid
  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status QuizSubmissionStatus @default(IN_PROGRESS)

  scoreTotal   Int?     @map("score_total") @db.SmallInt
  scoreMax     Int?     @map("score_max") @db.SmallInt
  scorePercent Int?     @map("score_percent") @db.SmallInt
  passed       Boolean? @map("passed")
  likertSum    Int?     @map("likert_sum") @db.SmallInt
  likertMax    Int?     @map("likert_max") @db.SmallInt

  answers QuizAnswer[]

  startedAt   DateTime  @default(now()) @map("started_at")
  submittedAt DateTime? @map("submitted_at")

  @@index([quizId, userId])
  @@index([userId])
  @@index([submittedAt(sort: Desc)])
  @@map("quiz_submissions")
}

model QuizAnswer {
  id           String         @id @default(uuid(7)) @db.Uuid
  submissionId String         @map("submission_id") @db.Uuid
  submission   QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String         @map("question_id") @db.Uuid
  question     QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// SINGLE_CHOICE: "A".."D"; LIKERT_5: "1".."5".
  value        String         @db.VarChar(10)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([submissionId, questionId], map: "quiz_answers_submission_question_unique")
  @@index([questionId])
  @@map("quiz_answers")
}

// ---------------------------------------------------------------
// Guruhlar va biriktirishlar
// ---------------------------------------------------------------

model Group {
  id            String  @id @default(uuid(7)) @db.Uuid
  nameUz        String  @map("name_uz") @db.VarChar(255)
  descriptionUz String? @map("description_uz") @db.Text
  teacherId     String  @map("teacher_id") @db.Uuid
  teacher       User    @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  isActive      Boolean @default(true) @map("is_active")

  members     GroupMember[]
  courses     CourseGroup[]
  quizzes     GroupQuiz[]
  assignments Assignment[]
  releases    GroupLessonRelease[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([teacherId])
  @@index([isActive])
  @@map("groups")
}

/// Talaba bir vaqtda faqat bitta guruhda (studentId unique).
model GroupMember {
  groupId   String   @map("group_id") @db.Uuid
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String   @unique @map("student_id") @db.Uuid
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now()) @map("joined_at")

  @@id([groupId, studentId])
  @@index([groupId])
  @@map("group_members")
}

model CourseGroup {
  courseId   String   @map("course_id") @db.Uuid
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groupId    String   @map("group_id") @db.Uuid
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Oldingi dars tugamaguncha keyingisi yopiq.
  sequential Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([courseId, groupId])
  @@index([groupId])
  @@map("course_groups")
}

model GroupQuiz {
  quizId           String    @map("quiz_id") @db.Uuid
  quiz             Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  groupId          String    @map("group_id") @db.Uuid
  group            Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  opensAt          DateTime? @map("opens_at")
  closesAt         DateTime? @map("closes_at")
  maxAttempts      Int?      @map("max_attempts") @db.SmallInt
  /// null bo'lsa Quiz.timeLimitMinutes qo'llanadi.
  timeLimitMinutes Int?      @map("time_limit_minutes") @db.SmallInt
  createdAt        DateTime  @default(now()) @map("created_at")

  @@id([quizId, groupId])
  @@index([groupId])
  @@map("group_quizzes")
}

// ---------------------------------------------------------------
// O'qish jarayoni
// ---------------------------------------------------------------

model LessonProgress {
  id            String    @id @default(uuid(7)) @db.Uuid
  studentId     String    @map("student_id") @db.Uuid
  student       User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId      String    @map("lesson_id") @db.Uuid
  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt   DateTime? @map("completed_at")
  lastViewedAt  DateTime  @default(now()) @map("last_viewed_at")
  firstViewedAt DateTime? @map("first_viewed_at")
  viewCount     Int       @default(0) @map("view_count")
  timeSpentSec  Int       @default(0) @map("time_spent_sec")
  /// 0..100 — dars ichida qancha o'qilgan.
  lastPosition  Int       @default(0) @map("last_position") @db.SmallInt

  @@unique([studentId, lessonId], map: "lesson_progress_student_lesson_unique")
  @@index([studentId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model StudySession {
  id            String    @id @default(uuid(7)) @db.Uuid
  studentId     String    @map("student_id") @db.Uuid
  student       User      @relation("StudySessionOwner", fields: [studentId], references: [id], onDelete: Cascade)
  lessonId      String?   @map("lesson_id") @db.Uuid
  lesson        Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  startedAt     DateTime  @default(now()) @map("started_at")
  endedAt       DateTime? @map("ended_at")
  activeSeconds Int       @default(0) @map("active_seconds")

  @@index([studentId])
  @@index([lessonId])
  @@index([startedAt(sort: Desc)])
  @@map("study_sessions")
}

model StudyEvent {
  id        String         @id @default(uuid(7)) @db.Uuid
  studentId String         @map("student_id") @db.Uuid
  student   User           @relation("StudyEventOwner", fields: [studentId], references: [id], onDelete: Cascade)
  type      StudyEventType
  refId     String?        @map("ref_id") @db.Uuid
  meta      Json?          @db.JsonB
  at        DateTime       @default(now())

  @@index([studentId, at(sort: Desc)])
  @@index([type])
  @@map("study_events")
}

// ---------------------------------------------------------------
// Topshiriqlar
// ---------------------------------------------------------------

model Assignment {
  id          String         @id @default(uuid(7)) @db.Uuid
  courseId    String?        @map("course_id") @db.Uuid
  course      Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lessonId    String?        @map("lesson_id") @db.Uuid
  lesson      Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  moduleId    String?        @map("module_id") @db.Uuid
  groupId     String         @map("group_id") @db.Uuid
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdById String         @map("created_by_id") @db.Uuid
  createdBy   User           @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  kind        AssignmentKind @default(TASK)

  titleUz            String    @map("title_uz") @db.VarChar(255)
  descriptionUz      String?   @map("description_uz") @db.Text
  dueAt              DateTime? @map("due_at")
  maxScore           Int       @default(100) @map("max_score") @db.SmallInt
  attachmentKey      String?   @map("attachment_key") @db.VarChar(512)
  attachmentFileName String?   @map("attachment_file_name") @db.VarChar(255)

  // TASK — kechikish siyosati
  allowLate          Boolean @default(false) @map("allow_late")
  latePenaltyPercent Int     @default(0) @map("late_penalty_percent") @db.SmallInt

  // TIMED — oyna va taymer
  startsAt         DateTime? @map("starts_at")
  endsAt           DateTime? @map("ends_at")
  timeLimitMinutes Int?      @map("time_limit_minutes") @db.SmallInt

  // QUESTIONNAIRE — test dvigateliga bog'lanadi
  quizId String? @map("quiz_id") @db.Uuid
  quiz   Quiz?   @relation(fields: [quizId], references: [id], onDelete: SetNull)

  submissions    AssignmentSubmission[]
  accommodations AssignmentAccommodation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([groupId])
  @@index([createdById])
  @@index([courseId])
  @@index([moduleId])
  @@index([dueAt])
  @@index([kind])
  @@map("assignments")
}

/// Alohida talabaga vaqt uzaytirish.
model AssignmentAccommodation {
  id           String     @id @default(uuid(7)) @db.Uuid
  assignmentId String     @map("assignment_id") @db.Uuid
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String     @map("student_id") @db.Uuid
  student      User       @relation("AssignmentAccommodation", fields: [studentId], references: [id], onDelete: Cascade)
  extraMinutes Int?       @map("extra_minutes") @db.SmallInt
  newDueAt     DateTime?  @map("new_due_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([assignmentId, studentId], map: "accommodation_assignment_student_unique")
  @@index([studentId])
  @@map("assignment_accommodations")
}

model AssignmentSubmission {
  id           String     @id @default(uuid(7)) @db.Uuid
  assignmentId String     @map("assignment_id") @db.Uuid
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String     @map("student_id") @db.Uuid
  student      User       @relation("SubmissionAuthor", fields: [studentId], references: [id], onDelete: Cascade)

  textUz      String?  @map("text_uz") @db.Text
  fileKey     String?  @map("file_key") @db.VarChar(512)
  fileName    String?  @map("file_name") @db.VarChar(255)
  submittedAt DateTime @default(now()) @map("submitted_at")

  score      Int?
  feedbackUz String?   @map("feedback_uz") @db.Text
  gradedById String?   @map("graded_by_id") @db.Uuid
  gradedBy   User?     @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedAt   DateTime? @map("graded_at")

  status           AssignmentSubmissionStatus @default(SUBMITTED)
  /// RETURNED bo'lsa talaba qayta topshiradi, attempt oshadi.
  attempt          Int                        @default(1) @db.SmallInt
  attemptStartedAt DateTime?                  @map("attempt_started_at")
  attemptDeadline  DateTime?                  @map("attempt_deadline")
  isLate           Boolean                    @default(false) @map("is_late")

  revisions AssignmentSubmissionRevision[]

  @@unique([assignmentId, studentId], map: "assignment_submissions_assignment_student_unique")
  @@index([studentId])
  @@index([status])
  @@map("assignment_submissions")
}

/// Har qaytarilgan (RETURNED) urinishning arxivi.
model AssignmentSubmissionRevision {
  id           String                     @id @default(uuid(7)) @db.Uuid
  submissionId String                     @map("submission_id") @db.Uuid
  submission   AssignmentSubmission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  attempt      Int                        @db.SmallInt
  textUz       String?                    @map("text_uz") @db.Text
  fileKey      String?                    @map("file_key") @db.VarChar(512)
  fileName     String?                    @map("file_name") @db.VarChar(255)
  submittedAt  DateTime                   @map("submitted_at")
  score        Int?
  feedbackUz   String?                    @map("feedback_uz") @db.Text
  gradedById   String?                    @map("graded_by_id") @db.Uuid
  gradedAt     DateTime?                  @map("graded_at")
  status       AssignmentSubmissionStatus
  createdAt    DateTime                   @default(now()) @map("created_at")

  @@index([submissionId])
  @@map("assignment_submission_revisions")
}

// PedResearch Lab Platform — Prisma schema (Phase 0)
// PostgreSQL 16 with UUIDv7 default IDs (via app-level uuid v7)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// Enums
// ---------------------------------------------------------------

enum RoleSlug {
  SUPER_ADMIN
  TEACHER
  STUDENT
}

enum AssignmentSubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
}

enum OrganizationType {
  CITY
  DISTRICT
  MAHALLA
  SCHOOL
  KINDERGARTEN
  UNIVERSITY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETE
  TOKEN_REFRESH
  TOKEN_REVOKED
}

enum LessonType {
  MARUZA
  AMALIY
  LABORATORIYA
  EKSKURSIYA
}

enum EducationLevel {
  MAKTABGACHA
  MAKTAB
  OLIY_TALIM
  RESERVED
}

enum AiMessageRole {
  USER
  ASSISTANT
}

enum EcoReportCategory {
  WASTE
  WATER
  GREEN_AREA
  AIR_NOISE
  ENERGY
  OTHER
}

enum EcoReportRisk {
  LOW
  MEDIUM
  HIGH
}

enum EcoReportStatus {
  REPORTED
  IN_REVIEW
  IN_PROGRESS
  RESOLVED
}

enum QuizQuestionType {
  SINGLE_CHOICE // A/B/C/D — one correct option, scored
  LIKERT_5 // 1..5 scale — survey question, not scored (contributes to likertSum)
}

enum QuizSubmissionStatus {
  IN_PROGRESS
  SUBMITTED
}

// ---------------------------------------------------------------
// Users, roles, permissions
// ---------------------------------------------------------------

model User {
  id              String    @id @db.Uuid
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String    @map("last_name") @db.VarChar(100)
  email           String    @unique @db.VarChar(255)
  phone           String?   @unique @db.VarChar(32)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  avatarUrl       String?   @map("avatar_url") @db.Text
  locale          String    @default("uz") @db.VarChar(8)
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  lastLoginIp     String?   @map("last_login_ip") @db.VarChar(45)
  isActive        Boolean   @default(true) @map("is_active")

  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  /**
   * Kim yaratgan: SUPER_ADMIN talaba/o'qituvchi uchun; o'qituvchi talaba uchun.
   */
  createdById        String? @map("created_by_id") @db.Uuid
  createdBy          User?   @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers       User[]  @relation("UserCreator")
  /**
   * Vaqtincha parol — birinchi login'da almashtirish talab qilinadi.
   */
  mustChangePassword Boolean @default(false) @map("must_change_password")

  roles           UserRole[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  passwordResets  PasswordResetToken[]
  ecoReports      EcoReport[]
  aiConversations AiConversation[]
  news            News[]
  quizSubmissions QuizSubmission[]

  // 3-rol LMS: o'qituvchi/talaba resurslari
  teachingGroups        Group[]                @relation("GroupTeacher")
  groupMembership       GroupMember?
  ownedCourses          Course[]               @relation("CourseOwner")
  ownedQuizzes          Quiz[]                 @relation("QuizOwner")
  lessonProgress        LessonProgress[]
  createdAssignments    Assignment[]           @relation("AssignmentCreator")
  assignmentSubmissions AssignmentSubmission[] @relation("SubmissionAuthor")
  gradedSubmissions     AssignmentSubmission[] @relation("SubmissionGrader")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

model Role {
  id          String   @id @db.Uuid
  slug        RoleSlug @unique
  nameUz      String   @map("name_uz") @db.VarChar(120)
  description String?  @db.VarChar(500)

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id     String @id @db.Uuid
  slug   String @unique @db.VarChar(120) // e.g. "users.create"
  module String @db.VarChar(60) // e.g. "users"
  action String @db.VarChar(60) // e.g. "create"
  nameUz String @map("name_uz") @db.VarChar(160)

  roles RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------
// Organizations (city → district → mahalla; also schools/universities)
// ---------------------------------------------------------------

model Organization {
  id       String         @id @db.Uuid
  parentId String?        @map("parent_id") @db.Uuid
  parent   Organization?  @relation("OrgTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Organization[] @relation("OrgTree")

  type      OrganizationType
  nameUz    String           @map("name_uz") @db.VarChar(255)
  code      String           @unique @db.VarChar(60) // e.g. "chirchiq", "kimyogar-mahalla"
  address   Json?            @db.JsonB
  latitude  Decimal?         @db.Decimal(10, 7)
  longitude Decimal?         @db.Decimal(10, 7)

  users      User[]
  ecoReports EcoReport[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([type])
  @@map("organizations")
}

// ---------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------

model AuditLog {
  id     String  @id @db.Uuid
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action      AuditAction
  subjectType String?     @map("subject_type") @db.VarChar(120)
  subjectId   String?     @map("subject_id") @db.Uuid
  changes     Json?       @db.JsonB
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  userAgent   String?     @map("user_agent") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([subjectType, subjectId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------
// PlatformSetting — Super Admin sozlaydigan yagona kalit-qiymatlar
// (AI API kaliti, model, boshqa integratsiyalar). Kalit unique,
// qiymat text (shifrlanmagan — .env kabi).
// ---------------------------------------------------------------

model PlatformSetting {
  key       String   @id @db.VarChar(80)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("platform_settings")
}

// ---------------------------------------------------------------
// News (Bosh sahifadagi yangiliklar oqimi)
// ---------------------------------------------------------------

model News {
  id                  String  @id @db.Uuid
  titleUz             String  @map("title_uz") @db.VarChar(255)
  bodyUz              String  @map("body_uz") @db.Text
  /// Optional file uploaded to MinIO — masalan rasm yoki hujjat.
  attachmentKey       String? @map("attachment_key") @db.VarChar(500)
  attachmentFileName  String? @map("attachment_file_name") @db.VarChar(255)
  attachmentMimeType  String? @map("attachment_mime_type") @db.VarChar(120)
  attachmentSizeBytes Int?    @map("attachment_size_bytes")

  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")

  authorId String? @map("author_id") @db.Uuid
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isPublished, publishedAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("news")
}

// ---------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------

model Notification {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String    @db.VarChar(120)
  titleUz String    @map("title_uz") @db.VarChar(255)
  bodyUz  String    @map("body_uz") @db.Text
  data    Json?     @db.JsonB
  readAt  DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, readAt])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

// ---------------------------------------------------------------
// Auth tokens
// ---------------------------------------------------------------

model RefreshToken {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  familyId  String    @map("family_id") @db.Uuid // rotation family — reuse detection
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime  @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------
// E-learning (Phase 5) — Courses & lessons
// ---------------------------------------------------------------

model Course {
  id             String  @id @db.Uuid
  slug           String  @unique @db.VarChar(80)
  nameUz         String  @map("name_uz") @db.VarChar(255)
  descriptionUz  String? @map("description_uz") @db.Text
  // Dinamik `education_level_items` jadvalidagi slug'ga havola qiladi. FK sifatida
  // biriktirilmagan — chunki daraja o'chirilsa ham kurs saqlanadi (level orphan
  // bo'ladi, UI'da "—" ko'rinadi va admin qayta biriktiradi).
  educationLevel String  @map("education_level") @db.VarChar(60)
  isPublished    Boolean @default(false) @map("is_published")

  /**
   * Kurs egasi — TEACHER o'ziniki, null bo'lsa SUPER_ADMIN tayinlaydi.
   */
  ownerId String? @map("owner_id") @db.Uuid
  owner   User?   @relation("CourseOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  lessons     Lesson[]
  materials   CourseMaterial[]
  groups      CourseGroup[]
  assignments Assignment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isPublished])
  @@index([educationLevel])
  @@index([ownerId])
  @@map("courses")
}

/// Dinamik ta'lim darajalari — Super Admin CRUD qila oladi. Sidebar shu jadvaldan
/// ro'yxatni oladi. `isBuiltIn=true` bo'lgan qatorlar o'chirilmaydi (asosiy 4 daraja).
model EducationLevelItem {
  id            String          @id @db.Uuid
  slug          String          @unique @db.VarChar(60)
  nameUz        String          @map("name_uz") @db.VarChar(120)
  descriptionUz String?         @map("description_uz") @db.VarChar(500)
  iconName      String          @default("GraduationCap") @map("icon_name") @db.VarChar(60)
  orderIndex    Int             @default(0) @map("order_index") @db.SmallInt
  linkedEnum    EducationLevel? @map("linked_enum")
  isBuiltIn     Boolean         @default(false) @map("is_built_in")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderIndex])
  @@map("education_level_items")
}

model Lesson {
  id       String @id @db.Uuid
  courseId String @map("course_id") @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  orderIndex  Int        @map("order_index") @db.SmallInt
  lessonType  LessonType @map("lesson_type")
  titleUz     String     @map("title_uz") @db.VarChar(255)
  objectiveUz String?    @map("objective_uz") @db.Text
  equipmentUz String?    @map("equipment_uz") @db.Text
  theoryUz    String?    @map("theory_uz") @db.Text
  procedureUz Json       @default("[]") @map("procedure_uz") @db.JsonB

  materials   CourseMaterial[]
  quizzes     Quiz[]
  progress    LessonProgress[]
  assignments Assignment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([courseId, orderIndex], map: "lessons_course_order_unique")
  @@index([courseId])
  @@index([lessonType])
  @@map("lessons")
}

/// Kurs materiallari (docx/pdf) + ularning matn holatida saqlangan indeksi.
/// contentText — RAG (chatbot) uchun, uploadda mammoth bilan chiqarilgan.
model CourseMaterial {
  id       String  @id @db.Uuid
  courseId String  @map("course_id") @db.Uuid
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId String? @map("lesson_id") @db.Uuid
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  fileName   String  @map("file_name") @db.VarChar(255)
  storageKey String  @unique @map("storage_key") @db.VarChar(512)
  mimeType   String  @map("mime_type") @db.VarChar(120)
  sizeBytes  Int     @map("size_bytes")
  uploadedBy String? @map("uploaded_by") @db.Uuid

  /// Fayldan chiqarilgan matn — chatbot RAG uchun (docx/txt). Yo'q bo'lsa null.
  contentText String? @map("content_text") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([courseId])
  @@index([lessonId])
  @@map("course_materials")
}

// ---------------------------------------------------------------
// AI Chatbot (Phase 7) — conversation history
// ---------------------------------------------------------------

model AiConversation {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String @db.VarChar(255)

  messages AiMessage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([updatedAt(sort: Desc)])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    AiMessageRole
  content String        @db.Text
  /// AI provayder tomonidan aytilgan token sarfi (billing statistikasi uchun).
  tokens  Int?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("ai_messages")
}

model EcoReport {
  id             String        @id @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  reportedBy     String        @map("reported_by") @db.Uuid
  reporter       User          @relation(fields: [reportedBy], references: [id], onDelete: Cascade)

  category      EcoReportCategory
  riskLevel     EcoReportRisk     @map("risk_level")
  status        EcoReportStatus   @default(REPORTED)
  descriptionUz String            @map("description_uz") @db.Text
  suggestionUz  String?           @map("suggestion_uz") @db.Text
  aiNoteUz      String?           @map("ai_note_uz") @db.Text

  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  locationLabel String?  @map("location_label") @db.VarChar(255)

  photoBeforeKey String? @map("photo_before_key") @db.VarChar(512)
  photoAfterKey  String? @map("photo_after_key") @db.VarChar(512)

  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([category])
  @@index([status])
  @@index([organizationId])
  @@index([createdAt(sort: Desc)])
  @@map("eco_reports")
}

// ---------------------------------------------------------------
// Quizzes / Tests (Phase 8) — attached to a Lesson
// ---------------------------------------------------------------

/// Dars tagidagi test/so'rovnoma. Bir xil quizda ikki tur savol aralash bo'lishi
/// mumkin (SINGLE_CHOICE — ballanadi, LIKERT_5 — faqat yig'iladi, baholanmaydi).
model Quiz {
  id       String  @id @db.Uuid
  /// Darsga biriktirilgan testlar — kurs kontekstida. null bo'lsa — "Ekologik
  /// monitoring" bo'limidagi standalone test.
  lessonId String? @map("lesson_id") @db.Uuid
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  titleUz       String  @map("title_uz") @db.VarChar(255)
  descriptionUz String? @map("description_uz") @db.Text
  /// Ball bilan baholanadigan savollar bo'yicha o'tish foizi (0..100).
  passPercent   Int     @default(60) @map("pass_percent") @db.SmallInt
  isPublished   Boolean @default(false) @map("is_published")

  /**
   * Test egasi — TEACHER o'ziniki, null = SUPER_ADMIN tomonidan yaratilgan global.
   */
  ownerId String? @map("owner_id") @db.Uuid
  owner   User?   @relation("QuizOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  questions   QuizQuestion[]
  submissions QuizSubmission[]
  groups      GroupQuiz[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lessonId])
  @@index([isPublished])
  @@map("quizzes")
}

/// options JSON formati:
///   SINGLE_CHOICE: [{"key":"A","textUz":"...","isCorrect":true}, ...]
///   LIKERT_5:      [] (bo'sh — variantlar 1..5 UI tomonidan render qilinadi)
model QuizQuestion {
  id     String @id @db.Uuid
  quizId String @map("quiz_id") @db.Uuid
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  orderIndex Int              @map("order_index") @db.SmallInt
  type       QuizQuestionType
  textUz     String           @map("text_uz") @db.Text
  options    Json             @default("[]") @db.JsonB

  answers QuizAnswer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([quizId, orderIndex], map: "quiz_questions_quiz_order_unique")
  @@index([quizId])
  @@map("quiz_questions")
}

/// Foydalanuvchining bitta urinishi. Bir odam quizni bir necha marta
/// topshirishi mumkin (har safar yangi submission). IN_PROGRESS holati
/// kelajakda "qoldirilgan" draft'lar uchun — hozircha hamma darhol SUBMITTED
/// bo'ladi.
model QuizSubmission {
  id     String @id @db.Uuid
  quizId String @map("quiz_id") @db.Uuid
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status QuizSubmissionStatus @default(IN_PROGRESS)

  /// Scored (SINGLE_CHOICE) metrics — null if the quiz has no scored questions.
  scoreTotal   Int?     @map("score_total") @db.SmallInt
  scoreMax     Int?     @map("score_max") @db.SmallInt
  scorePercent Int?     @map("score_percent") @db.SmallInt
  passed       Boolean? @map("passed")

  /// Survey (LIKERT_5) metrics — null if there are no survey questions.
  likertSum Int? @map("likert_sum") @db.SmallInt
  likertMax Int? @map("likert_max") @db.SmallInt

  answers QuizAnswer[]

  startedAt   DateTime  @default(now()) @map("started_at")
  submittedAt DateTime? @map("submitted_at")

  @@index([quizId, userId])
  @@index([userId])
  @@index([submittedAt(sort: Desc)])
  @@map("quiz_submissions")
}

model QuizAnswer {
  id           String         @id @db.Uuid
  submissionId String         @map("submission_id") @db.Uuid
  submission   QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String         @map("question_id") @db.Uuid
  question     QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// SINGLE_CHOICE: tanlangan option kaliti ("A", "B", "C", "D").
  /// LIKERT_5: raqam "1".."5".
  value String @db.VarChar(10)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([submissionId, questionId], map: "quiz_answers_submission_question_unique")
  @@index([questionId])
  @@map("quiz_answers")
}

// ---------------------------------------------------------------
// LMS: Group / GroupMember (3-rol model: TEACHER guruhlari + STUDENT a'zoligi)
// ---------------------------------------------------------------

/**
 * O'qituvchining guruhi (sinf/to'g'arak). TEACHER o'z guruhlarini yaratadi va boshqaradi.
 * SUPER_ADMIN hamma guruhlarni ko'ra oladi.
 */
model Group {
  id            String  @id @db.Uuid
  nameUz        String  @map("name_uz") @db.VarChar(255)
  descriptionUz String? @map("description_uz") @db.Text

  /**
   * Guruhning asosiy o'qituvchisi (egasi).
   */
  teacherId String @map("teacher_id") @db.Uuid
  teacher   User   @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true) @map("is_active")

  members     GroupMember[]
  courses     CourseGroup[]
  quizzes     GroupQuiz[]
  assignments Assignment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([teacherId])
  @@index([isActive])
  @@map("groups")
}

/**
 * Talaba <-> guruh a'zoligi. QARO R: talaba bir vaqtda FAQAT bitta guruhda bo'ladi
 * (studentId bo'yicha unique). Keyinchalik ko'p guruhli qilish uchun shu
 * cheklovni olib tashlash kifoya qiladi.
 */
model GroupMember {
  groupId   String @map("group_id") @db.Uuid
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String @unique @map("student_id") @db.Uuid
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now()) @map("joined_at")

  @@id([groupId, studentId])
  @@index([groupId])
  @@map("group_members")
}

// ---------------------------------------------------------------
// Course <-> Group biriktirish (talaba kursni faqat guruhi orqali ko'radi)
// ---------------------------------------------------------------

model CourseGroup {
  courseId String @map("course_id") @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groupId  String @map("group_id") @db.Uuid
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([courseId, groupId])
  @@index([groupId])
  @@map("course_groups")
}

// ---------------------------------------------------------------
// Quiz <-> Group biriktirish (STUDENT quiz'ni faqat shu orqali ko'radi)
// ---------------------------------------------------------------

model GroupQuiz {
  quizId      String    @map("quiz_id") @db.Uuid
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  groupId     String    @map("group_id") @db.Uuid
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  opensAt     DateTime? @map("opens_at")
  closesAt    DateTime? @map("closes_at")
  maxAttempts Int?      @map("max_attempts") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at")

  @@id([quizId, groupId])
  @@index([groupId])
  @@map("group_quizzes")
}

// ---------------------------------------------------------------
// LessonProgress — talaba darsni ko'rib bo'lganligini belgilaydi
// ---------------------------------------------------------------

model LessonProgress {
  id        String @id @db.Uuid
  studentId String @map("student_id") @db.Uuid
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId  String @map("lesson_id") @db.Uuid
  lesson    Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  completedAt  DateTime? @map("completed_at")
  lastViewedAt DateTime  @default(now()) @map("last_viewed_at")

  @@unique([studentId, lessonId], map: "lesson_progress_student_lesson_unique")
  @@index([studentId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// ---------------------------------------------------------------
// Assignment / AssignmentSubmission — guruhga beriladigan topshiriqlar
// ---------------------------------------------------------------

model Assignment {
  id          String  @id @db.Uuid
  courseId    String? @map("course_id") @db.Uuid
  course      Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lessonId    String? @map("lesson_id") @db.Uuid
  lesson      Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  groupId     String  @map("group_id") @db.Uuid
  group       Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdById String  @map("created_by_id") @db.Uuid
  createdBy   User    @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Cascade)

  titleUz       String    @map("title_uz") @db.VarChar(255)
  descriptionUz String?   @map("description_uz") @db.Text
  dueAt         DateTime? @map("due_at")
  maxScore      Int       @default(100) @map("max_score") @db.SmallInt
  /**
   * Ixtiyoriy biriktirilgan fayl (masalan topshiriq shabloni).
   */
  attachmentKey String?   @map("attachment_key") @db.VarChar(512)

  submissions AssignmentSubmission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([groupId])
  @@index([createdById])
  @@index([courseId])
  @@index([dueAt])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String     @id @db.Uuid
  assignmentId String     @map("assignment_id") @db.Uuid
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String     @map("student_id") @db.Uuid
  student      User       @relation("SubmissionAuthor", fields: [studentId], references: [id], onDelete: Cascade)

  textUz   String? @map("text_uz") @db.Text
  /**
   * MinIO storage key — null bo'lsa fayl yuklanmagan.
   */
  fileKey  String? @map("file_key") @db.VarChar(512)
  fileName String? @map("file_name") @db.VarChar(255)

  submittedAt DateTime @default(now()) @map("submitted_at")

  score      Int?
  feedbackUz String?   @map("feedback_uz") @db.Text
  gradedById String?   @map("graded_by_id") @db.Uuid
  gradedBy   User?     @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedAt   DateTime? @map("graded_at")

  status AssignmentSubmissionStatus @default(SUBMITTED)

  @@unique([assignmentId, studentId], map: "assignment_submissions_assignment_student_unique")
  @@index([studentId])
  @@index([status])
  @@map("assignment_submissions")
}

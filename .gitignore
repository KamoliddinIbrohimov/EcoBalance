# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Stray temporary files from docker-compose bind mounts
_tmp_*

# Claude Code agent sessions
.claude/

# Env
.env
.env.local
.env.*.local
!.env.example

# Node / pnpm
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*

# Turborepo
.turbo/

# Next.js
.next/
out/
next-env.d.ts

# NestJS
dist/
tmp/
apps/api/src/metadata.ts

# Stray compiled JS next to TS sources (should never be checked in)
packages/shared/src/**/*.js
packages/shared/src/**/*.js.map
packages/shared/src/**/*.d.ts
packages/shared/src/**/*.d.ts.map

# Prisma
apps/api/prisma/generated/
apps/api/prisma/*.db

# Coverage / test
coverage/
.nyc_output/
*.tsbuildinfo

# Docker
.docker/data/
docker-compose.override.yml

# Local server deploy notes (SSH, IPs, ops commands) — never commit
SERVER.md
DEPLOY.local.md

# Logs
*.log
logs/

# Archive / binary materials — only extracted files go in git
*.rar
*.zip
*.7z

# Office temp files
~$*
